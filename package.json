{
  "name": "x-country-withheld-viewer",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "Browser extension and userscript that show country-withheld public posts on X inline, rendered by X itself, with a small marker.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve:userscript": "node scripts/serve-userscript.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "store:assets": "node scripts/build.mjs && node scripts/store-assets.mjs",
    "probe": "node tools/probe.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
